<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Top Handle Bar -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#D1D5DB" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_virtual_param"
            app:tint="@color/genie_cyan"
            android:contentDescription="Virtual Parameter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Virtual Parameter &amp; Mapping"
                android:textColor="@color/genie_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVpServerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tanam skrip otomatis atau edit mapping TR-069"
                android:textColor="@color/genie_cyan"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseVp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@color/genie_text_primary"
            android:contentDescription="Tutup" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="520dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card 1: 1-Click Tanam Virtual Parameter ke Server -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/genie_card_bg"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/genie_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⚡ Tanam Parameter ke Server GenieACS"
                            android:textColor="@color/genie_text_primary"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvServerVpStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pill"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="Memeriksa..."
                            android:textColor="@color/genie_text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Pasang paket script VirtualParameter resmi (RXPower, pppoeUsername, WlanPassword, WlanSSID, getponmode, MacAddress, userconnected, uptimeDevice, vlan) langsung ke database server GenieACS via NBI API."
                        android:textColor="@color/genie_text_primary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />

                    <ProgressBar
                        android:id="@+id/progressInstallVp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:indeterminate="true"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnInstallStandardVp"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="🚀 Tanam / Pasang Parameter ke Server"
                        android:textColor="#FFFFFF"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/genie_blue"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Editable Parameter Mapping (Tersimpan di APK) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/genie_card_bg"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/genie_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛠️ Custom Parameter Mapping (di APK)"
                        android:textColor="@color/genie_text_primary"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="12dp"
                        android:text="Atur kata kunci VirtualParameter atau path TR-069 mentah kustom yang diprioritaskan saat memuat data ONU (pisahkan dengan koma):"
                        android:textColor="@color/genie_text_primary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />

                    <!-- 1. Optical Rx Power -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡 Redaman Optik (RX Power)"
                        android:textColor="@color/genie_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etVpRxPower"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_search"
                        android:hint="Default: RXPower, rxPower, redaman, opticalPower"
                        android:paddingHorizontal="12dp"
                        android:singleLine="true"
                        android:textColor="@color/genie_text_primary"
                        android:textColorHint="@color/genie_text_muted"
                        android:textSize="12.5sp" />

                    <!-- 2. PPPoE Username -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👤 PPPoE Username"
                        android:textColor="@color/genie_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etVpPppoe"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_search"
                        android:hint="Default: pppoeUsername, pppUsername, Username"
                        android:paddingHorizontal="12dp"
                        android:singleLine="true"
                        android:textColor="@color/genie_text_primary"
                        android:textColorHint="@color/genie_text_muted"
                        android:textSize="12.5sp" />

                    <!-- 3. Wi-Fi SSID -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📶 Wi-Fi SSID"
                        android:textColor="@color/genie_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etVpSsid"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_search"
                        android:hint="Default: SSID, WlanSSID, wifi_ssid, SSID1"
                        android:paddingHorizontal="12dp"
                        android:singleLine="true"
                        android:textColor="@color/genie_text_primary"
                        android:textColorHint="@color/genie_text_muted"
                        android:textSize="12.5sp" />

                    <!-- 4. Customer Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏷️ Nama Pelanggan"
                        android:textColor="@color/genie_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etVpCustName"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_search"
                        android:hint="Default: customerName, namaPelanggan, nama"
                        android:paddingHorizontal="12dp"
                        android:singleLine="true"
                        android:textColor="@color/genie_text_primary"
                        android:textColorHint="@color/genie_text_muted"
                        android:textSize="12.5sp" />

                    <!-- 5. PON Mode -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ Mode PON (GPON/EPON)"
                        android:textColor="@color/genie_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etVpPonMode"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_search"
                        android:hint="Default: getponmode, ponMode, AccessType"
                        android:paddingHorizontal="12dp"
                        android:singleLine="true"
                        android:textColor="@color/genie_text_primary"
                        android:textColorHint="@color/genie_text_muted"
                        android:textSize="12.5sp" />

                    <!-- Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnResetMapping"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="🔄 Reset Default"
                            android:textColor="@color/genie_text_primary"
                            app:strokeColor="@color/genie_blue"
                            app:strokeWidth="1.5dp"
                            android:textAllCaps="false"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            app:cornerRadius="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveMapping"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="💾 Simpan Mapping"
                            android:textColor="#FFFFFF"
                            android:textAllCaps="false"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/genie_blue"
                            app:cornerRadius="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Status Engine Bawaan APK -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/genie_card_bg"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/genie_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ℹ️ Engine Fallback Bawaan APK: AKTIF"
                        android:textColor="@color/status_online"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="APK secara otomatis mencari puluhan path TR-069 mentah (ZTE, Huawei, Fiberhome, VSOL, Nokia, TR-098 &amp; TR-181) apabila server belum memasang VirtualParameter."
                        android:textColor="@color/genie_text_primary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
